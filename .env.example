# Copy to .env and fill in. Never commit real secrets.

# Postgres. Local dev uses compose.yaml; production uses Supabase's connection string
# (use the pooled "transaction" URL for serverless hosts, direct URL for a long-running Node server).
DATABASE_URL="postgres://bilidito:bilidito_dev@localhost:5432/bilidito"

# Public origin of the app (used for CSRF checks and links in emails).
ORIGIN="http://localhost:5173"

# 32+ random characters, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=""

# SMTP connection URL, e.g. smtps://user:pass@smtp.example.com:465
# Leave empty in development to print emails to the server console.
SMTP_URL=""
EMAIL_FROM="BILIDITO <no-reply@example.com>"
